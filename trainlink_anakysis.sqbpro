<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="/Users/munnanaharki123gmail.com/Documents/nsw-trainlink-sql/trainlink_anakysis.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="805"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="trainlink_journeys" custom_title="0" dock_id="1" table="4,18:maintrainlink_journeys"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000001fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000010100ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">SELECT *
FROM trainlink_journeys 
LIMIT 10 ; 

SELECT *
FROM passenger_type
LIMIT 10 ; 

SELECT 
count (*) 
FROM trainlink_journeys ; 

SELECT service_description , 
	SUM (trips) as total_trips 
FROM trainlink_journeys 
WHERE transport_type = 'Train' 
GROUP BY service_description
ORDER BY total_trips DESC 
LIMIT 10 ; 

SELECT financial_year,
       SUM(trips) AS total_trips
FROM trainlink_journeys
WHERE trips IS NOT NULL
GROUP BY financial_year
ORDER BY financial_year;

SELECT ticket_type,
	sum (trips) AS total_trips
FROM passenger_type 
WHERE ticket_type != 'Grand Total' 
GROUP BY ticket_type
ORDER BY total_trips DESC ; 

SELECT month,
	sum (trips) AS total_trips
FROM trainlink_journeys
GROUP BY month
ORDER BY total_trips DESC ; 

SELECT transport_type, 
	sum (trips) AS total_trips
FROM trainlink_journeys
GROUP BY transport_type
ORDER BY total_trips DESC ;

SELECT service_description, 
	sum(trips) AS total_trip
FROM trainlink_journeys 
WHERE transport_type = 'Coach' 
AND trips IS NOT NULL 
AND service_description IS NOT NULL 
GROUP BY service_description 
ORDER BY total_trip DESC
LIMIT 10 ; 









</sql><current_tab id="0"/></tab_sql></sqlb_project>
